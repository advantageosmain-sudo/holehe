{
  "siteName": "Holehe project guide",
  "siteType": "static documentation",
  "framework": "vanilla HTML and CSS",
  "sourceDirectory": "site",
  "buildCommand": "python3 scripts/site-builder/build.py",
  "devCommand": "python3 -m http.server 8000 --directory site",
  "outputDirectory": "dist",
  "pages": [
    "/",
    "/install/",
    "/usage/",
    "/privacy/",
    "/lookup/"
  ],
  "contentSources": [
    "README.md",
    "setup.py",
    "LICENSE.md"
  ],
  "deploymentTarget": "Railway authenticated API; private ChatGPT Sites interface; static guide remains local",
  "environmentVariables": [
    "HOLEHE_ALLOWED_EMAIL",
    "LOOKUP_API_TOKEN"
  ],
  "status": "DEPLOYMENT_BLOCKED",
  "backend": {
    "framework": "FastAPI / Uvicorn",
    "sourceDirectory": "web",
    "entrypoint": "web.hosted:create_app",
    "buildCommand": "docker build -f Dockerfile.railway -t holehe-api .",
    "deploymentConfig": "railway.json",
    "replicas": 1,
    "healthcheckPath": "/healthz",
    "authenticatedHealthPath": "/health",
    "lookupPath": "/api/lookup"
  },
  "externalDeployment": {
    "status": "BLOCKED",
    "blocker": "Railway GitHub app authorization for this repository, selected permitted email, runtime secrets and verified HTTPS domain are required."
  }
}
